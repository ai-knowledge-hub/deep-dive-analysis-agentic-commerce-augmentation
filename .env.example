# =============================================================================
# LOCAL DEVELOPMENT (copy to .env.local and adjust as needed)
# =============================================================================

# Catalog source selection: mock | shopify | google_shopping | google_merchant
CATALOG_SOURCE=mock

# SQLite path for local experiments
DATABASE_PATH=./tmp/local.db

# Prefer local embeddings when available
EMBEDDING_PREFER_LOCAL=true

# LLM provider (use OpenRouter locally to avoid Gemini token usage)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Frontend origin (Next.js dev server)
FRONTEND_URL=http://localhost:3000

# Allowlisted hosts for MCP web_fetch tool (comma-separated)
WEB_FETCH_ALLOWLIST=example.com,docs.yourdomain.com

# Clerk (Next.js auth, free tier)
# Create an app in Clerk to get these keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/


# =============================================================================
# DEV / PREVIEW DEPLOYMENTS (store as env secrets or .env.dev)
# =============================================================================

CATALOG_SOURCE=google_merchant
GOOGLE_MERCHANT_FEED_PATH=/absolute/path/to/google_merchant_feed.json
DATABASE_PATH=./db/empowerment.dev.db

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# Optional: override priority order (comma-separated list)
# GEMINI_MODEL_PRIORITY=gemini-3-pro-preview,gemini-2.0-flash

FRONTEND_URL=https://dev.yourdomain.com

# Allowlisted hosts for MCP web_fetch tool (comma-separated)
WEB_FETCH_ALLOWLIST=example.com,docs.yourdomain.com


# =============================================================================
# PRODUCTION DEPLOYMENTS (managed via platform secrets, shown here for reference)
# =============================================================================

# CATALOG_SOURCE=google_merchant
# GOOGLE_MERCHANT_FEED_PATH=/secure/path/or/storage
# DATABASE_PATH=/var/lib/app/prod.db

# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3-pro
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# FRONTEND_URL=https://app.yourdomain.com
# WEB_FETCH_ALLOWLIST=docs.yourdomain.com
