# =============================================================================
# LOCAL DEVELOPMENT (copy to .env.local and adjust as needed)
# =============================================================================

# SQLite path for local experiments
DATABASE_PATH=./tmp/local.db

# Protocol data mode: "demo" uses seeded ACP/UCP data and relaxes strict checks.
# Set to "live" in deployed environments with real feeds/profiles.
PROTOCOL_MODE=demo
# Relax UCP profile oneOf validation where schemas overlap (demo/local only).
UCP_RELAX_ONEOF=true

# Prefer local embeddings when available
EMBEDDING_PREFER_LOCAL=true

# Comma-separated admin user IDs (bypass client_id requirement)
ADMIN_USER_IDS=

# LLM provider (use OpenRouter locally to avoid Gemini token usage)
LLM_PROVIDER=openrouter
# For local dev, you can use the Gemini CLI provider (requires `gemini` CLI login):
# LLM_PROVIDER=gemini_cli
# GEMINI_CLI_ALLOW_TOOLS=1
# GEMINI_CLI_MODEL=gemini-2.0-flash
# GEMINI_CLI_TIMEOUT_S=45
# GEMINI_CLI_MAX_SYSTEM_CHARS=1800
# SerpAPI (optional, enables Google-like search results in research)
# SERPAPI_API_KEY=
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_VALIDATION_API_KEY=
OPENROUTER_VALIDATION_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_VALIDATION_API_KEY=
OPENAI_VALIDATION_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=1024
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_VALIDATION_API_KEY=
ANTHROPIC_VALIDATION_MODEL=claude-3-5-sonnet-20240620
ANTHROPIC_TEMPERATURE=0.3
ANTHROPIC_MAX_TOKENS=1024

# Frontend origin (Next.js dev server)
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:8000
NEXT_PUBLIC_PROTOCOL_MODE=demo

# Provider-run synthetic validation integrations (optional, feature-flagged)
ENABLE_PROVIDER_VALIDATION_INTEGRATIONS=false
VALIDATION_CALLBACK_SIGNING_SECRET=
REGISTRY_APPROVAL_SIGNING_SECRET=
VALIDATION_CALLBACK_TTL_SECONDS=900
OPENAI_MCP_LAUNCH_URL=https://chatgpt.com/
GEMINI_FUNCTION_LAUNCH_URL=https://gemini.google.com/

# Allowlisted hosts for MCP web_fetch tool (comma-separated)
# Add search hosts if you want deterministic research fallback.
WEB_FETCH_ALLOWLIST=example.com,docs.yourdomain.com,duckduckgo.com,google.com
# Dev-only: allow all hosts for research (not for production).
# WEB_FETCH_ALLOW_ALL=1

# Clerk (Next.js auth, free tier)
# Create an app in Clerk to get these keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/


# =============================================================================
# DEV / PREVIEW DEPLOYMENTS (store as env secrets or .env.dev)
# =============================================================================

DATABASE_PATH=./tmp/empowerment.dev.db
PROTOCOL_MODE=live
UCP_RELAX_ONEOF=false

LLM_PROVIDER=gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_VALIDATION_API_KEY=
GEMINI_VALIDATION_MODEL=gemini-3-pro-preview
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: override priority order (comma-separated list)
# GEMINI_MODEL_PRIORITY=gemini-3-pro-preview,gemini-2.0-flash

FRONTEND_URL=https://dev.yourdomain.com
NEXT_PUBLIC_PROTOCOL_MODE=live

# Allowlisted hosts for MCP web_fetch tool (comma-separated)
WEB_FETCH_ALLOWLIST=example.com,docs.yourdomain.com


# =============================================================================
# PRODUCTION DEPLOYMENTS (managed via platform secrets, shown here for reference)
# =============================================================================

# DATABASE_PATH=/var/lib/app/prod.db
# PROTOCOL_MODE=live
# UCP_RELAX_ONEOF=false

# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3-pro
# GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# FRONTEND_URL=https://app.yourdomain.com
# NEXT_PUBLIC_PROTOCOL_MODE=live
# WEB_FETCH_ALLOWLIST=docs.yourdomain.com
