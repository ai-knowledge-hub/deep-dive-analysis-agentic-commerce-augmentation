{
  "name": "agentic-commerce-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm exec next dev",
    "build": "pnpm exec next build",
    "start": "pnpm exec next start",
    "lint": "pnpm exec next lint",
    "typecheck": "pnpm exec tsc --noEmit --pretty false",
    "complexity-check": "node ../scripts/checks/web_complexity_check.mjs",
    "ui-language-check": "node ../scripts/checks/ui_language_check.mjs",
    "test": "pnpm exec vitest run",
    "test:watch": "pnpm exec vitest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm ui-language-check && pnpm complexity-check && pnpm build",
    "test:e2e": "NEXT_PUBLIC_AUTH_MODE=mock NEXT_PUBLIC_ALLOW_MOCK_AUTH_IN_PRODUCTION=true pnpm run build && NEXT_PUBLIC_AUTH_MODE=mock NEXT_PUBLIC_ALLOW_MOCK_AUTH_IN_PRODUCTION=true pnpm exec playwright test",
    "web:dev": "pnpm run dev",
    "api:dev": "uvicorn api.main:app --reload"
  },
  "dependencies": {
    "@clerk/nextjs": "5.5.5",
    "ai": "3.0.25",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.12.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.11.30",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.21",
    "eslint": "8.56.0",
    "eslint-config-next": "14.2.5",
    "jsdom": "26.1.0",
    "typescript": "5.4.5",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@10.15.1+sha512.34e538c329b5553014ca8e8f4535997f96180a1d0f614339357449935350d924e22f8614682191264ec33d1462ac21561aff97f6bb18065351c162c7e8f6de67"
}
